# ---------------------------------------------------------------------------
# GoLinks server configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------

# HTTP port. 80 lets employees type http://go/xyz with no port number.
# Binding a port below 1024 needs root or CAP_NET_BIND_SERVICE (see README).
PORT=80

# Interface to bind. 0.0.0.0 = all interfaces (LAN). Use 127.0.0.1 behind a reverse proxy.
HOST=0.0.0.0

# SQLite database file (created automatically, parent directory included).
DB_PATH=./data/golinks.db

# Directory containing the built React app (output of `npm run build`).
STATIC_DIR=./dist

# Seed the sample links the first time the database is created.
SEED_SAMPLE_DATA=true

# Allow admins to wipe links / audit log back to the samples from the UI. Keep false in production.
ALLOW_DATA_RESET=false

# Set to true when running behind a reverse proxy (nginx, Traefik, IIS ARR) so req.ip is correct.
TRUST_PROXY=false

# Log one line per request (including the redirect target for 302s).
LOG_REQUESTS=true

# --- Sign-in ---------------------------------------------------------------
# First administrator. Created (or promoted and re-activated) at startup. The password is only
# applied while the account has none, so changing it in the app is never undone by a restart.
# After first sign-in, remove ADMIN_PASSWORD from this file.
ADMIN_EMAIL=admin@yourcompany.local
ADMIN_PASSWORD=
ADMIN_NAME=GoLinks Administrator

# Demo / evaluation mode. Gives the sample admin and employee accounts known passwords
# (Admin@12345, Employee@12345) and shows them on the sign-in page with one-click fill.
# NEVER enable on a server with real links: anyone on the LAN could sign in as admin.
# Turning it off again removes those demo passwords at the next start.
DEMO_MODE=false

# How long a sign-in lasts, in hours.
SESSION_TTL_HOURS=12

# Set to true only if the app is served over HTTPS (marks the session cookie Secure).
COOKIE_SECURE=false

# --- Insights --------------------------------------------------------------
# Days of per-click history kept for trend charts (total click counts are kept forever).
CLICK_RETENTION_DAYS=365

# --- Docker only -----------------------------------------------------------
# Host port published by docker-compose (the container itself listens on 8080).
HOST_PORT=80

# --- Development only ------------------------------------------------------
# Where the Vite dev server (port 3000) proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:3001
# Override the API origin baked into the client build (leave empty for same-origin).
VITE_API_BASE_URL=
